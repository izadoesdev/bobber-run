; Bobber Run, Godot 4.7 port. Web first, so it renders with the Compatibility renderer (WebGL 2).

config_version=5

[application]

config/name="Bobber Run"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/main_scene="res://scenes/game.tscn"

